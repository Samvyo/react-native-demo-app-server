PORT=3000
ACCESS_KEY=your_access_key
SECRET_ACCESS_KEY=your_secret_access_key

# ── Who may use the access key ───────────────────────────────────────────────
# Every access-key request (a session token, a camera's presence token) is
# refused until you choose a check. Any of (comma-separated):
#   device  cameras, each with its own secret (npm run add-device)
#   jwt     your apps' users, with a token your sign-in issued
#   custom  your own code in relayAuth.js (the default)
# RELAY_AUTH=device,jwt
#
# device: the device list (holds only hashes of the secrets).
# RELAY_DEVICES_FILE=/etc/samvyo-relay/devices.json
#
# jwt: exactly one of these verifies the token —
# RELAY_JWT_JWKS_URL=https://login.example.com/.well-known/jwks.json
# RELAY_JWT_PUBLIC_KEY_FILE=/etc/samvyo-relay/login-public.pem
# RELAY_JWT_SECRET=<a shared HS256 secret, 32+ characters>
# RELAY_JWT_ISSUER=https://login.example.com/
# RELAY_JWT_AUDIENCE=samvyo-relay
# The claim with the role (a string, or {"<roomId>": "moderator", "*": "participant"}),
# your names for the roles, and the role when the token has none:
# RELAY_JWT_ROLE_CLAIM=samvyo_role
# RELAY_JWT_ROLE_MAP=host=moderator,member=participant
# RELAY_JWT_DEFAULT_ROLE=participant
# The claim listing the rooms a token is good for (recommended):
# RELAY_JWT_ROOM_CLAIM=samvyo_rooms
# RELAY_JWT_ALGORITHMS=RS256
# RELAY_JWT_CLOCK_TOLERANCE_SEC=30
# RELAY_JWT_JWKS_CACHE_SEC=600
#
# For a LOCAL bench only, this skips every check — anyone who can reach the
# relay then mints with your key, as any role:
# RELAY_ALLOW_ANONYMOUS=true
# Browser origins allowed to call the relay (your meeting UI), comma-separated.
# Unset = any origin.
# RELAY_ALLOWED_ORIGINS=https://meet.example.com
# Token requests per caller address per minute (0 = no limit). Behind a proxy,
# set RELAY_TRUST_PROXY (express "trust proxy") so the caller's address is seen.
# RELAY_RATE_LIMIT_PER_MIN=60
# RELAY_TRUST_PROXY=1
